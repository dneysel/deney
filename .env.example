# Empty/missing gateway token keeps local development in simulation mode.
CHATBOT_API_TOKEN=
MODEL_PROVIDER=simulation
MODEL_NAME=local-model
UI_AUTO_AUTH=true
HOST=0.0.0.0
PORT=8000

# Optional local llama.cpp server settings.
LLAMACPP_URL=http://127.0.0.1:8080
# Set CHATBOT_API_TOKEN before selecting MODEL_PROVIDER=llamacpp.