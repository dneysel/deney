# Copy to .env.gpu, replace example values, and place the GGUF under MODEL_DIR.
CHATBOT_API_TOKEN=replace-with-a-long-random-user-token
INFERENCE_SERVICE_TOKEN=replace-with-a-different-long-random-service-token
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

MODEL_PROVIDER=llamacpp
MODEL_NAME=local-model
AVAILABLE_MODELS=local-model
MODEL_DIR=./models
MODEL_FILE=model.gguf
CONTEXT_SIZE=4096
GPU_LAYERS=99
VISION_ENABLED=false
UI_AUTO_AUTH=true